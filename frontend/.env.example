# Copy to .env.local. KHÔNG commit.

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Storage public URL (cho hiển thị ảnh / GLB preview)
# DEV (MinIO local):
NEXT_PUBLIC_STORAGE_PUBLIC_URL=http://localhost:9000

# STAGING/PROD (Supabase):
# NEXT_PUBLIC_STORAGE_PUBLIC_URL=https://YOUR-PROJECT-REF.supabase.co/storage/v1/object/public

# App
NEXT_PUBLIC_APP_NAME=3D Printing PIM
NEXT_PUBLIC_DEFAULT_LOCALE=vi

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=

# Feature flags (optional)
NEXT_PUBLIC_ENABLE_3D_VIEWER=true
NEXT_PUBLIC_ENABLE_POS_OFFLINE=false
