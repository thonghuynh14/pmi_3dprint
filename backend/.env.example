# Copy to .env và điền giá trị. KHÔNG commit .env.
#
# DEFAULT: Local dev với Postgres + MinIO trong Docker.
# Để switch sang Supabase (staging/prod): comment local block, uncomment Supabase block.

# =============================================================================
# Django
# =============================================================================
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-generate-with-django.core.management.utils.get_random_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# Database — chọn 1 trong 2 block dưới
# =============================================================================

# === Block A: Local Postgres (docker-compose) — DEFAULT ===
DATABASE_URL=postgresql://pim_user:pim_pass@localhost:5432/pim_dev
DATABASE_CONN_MAX_AGE=60
DATABASE_DISABLE_SERVER_SIDE_CURSORS=False

# === Block B: Supabase Postgres (staging/prod) ===
# Lấy từ Supabase Dashboard → Project Settings → Database
# Dùng Transaction Pooler (port 6543) cho production
#
# DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# DATABASE_CONN_MAX_AGE=0
# DATABASE_DISABLE_SERVER_SIDE_CURSORS=True

# =============================================================================
# Redis (local docker)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# Storage — chọn 1 trong 2 block dưới
# =============================================================================

# === Block A: Local MinIO (docker-compose) — DEFAULT ===
STORAGE_BACKEND=s3_compatible
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_DESIGN_FILES=design-files
STORAGE_BUCKET_MEDIA=media-assets
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=False
STORAGE_CDN_URL=http://localhost:9000

# === Block B: Supabase Storage (staging/prod) ===
# Lấy từ Supabase Dashboard → Project Settings → API
# Supabase Storage endpoint: https://YOUR-PROJECT.supabase.co/storage/v1/s3
#
# STORAGE_BACKEND=s3_compatible
# STORAGE_ENDPOINT_URL=https://YOUR-PROJECT-REF.supabase.co/storage/v1/s3
# STORAGE_ACCESS_KEY=YOUR-PROJECT-REF
# STORAGE_SECRET_KEY=YOUR-SERVICE-ROLE-KEY-NEVER-COMMIT
# STORAGE_BUCKET_DESIGN_FILES=design-files
# STORAGE_BUCKET_MEDIA=media-assets
# STORAGE_REGION=ap-southeast-1
# STORAGE_USE_SSL=True
# STORAGE_CDN_URL=https://YOUR-PROJECT-REF.supabase.co/storage/v1/object/public

# =============================================================================
# JWT (Auth)
# =============================================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=change-me-secure-random-256-bit

# =============================================================================
# Marketplace credentials (encrypted in DB qua MarketplaceCredential model)
# Các keys dưới là app-level (partner_id, app_key) — không phải shop token
# =============================================================================
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SANDBOX=True

LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_REGION=VN

TIKI_CLIENT_ID=
TIKI_CLIENT_SECRET=

# =============================================================================
# Field encryption (cho MarketplaceCredential token storage)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =============================================================================
FIELD_ENCRYPTION_KEY=

# =============================================================================
# Monitoring (optional)
# =============================================================================
SENTRY_DSN=
LOG_LEVEL=INFO

# =============================================================================
# Email (optional, password reset)
# =============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@3dprintpim.local
# For production:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# =============================================================================
# Vietnamese cost defaults (BR-005)
# =============================================================================
ELECTRICITY_PRICE_VND_PER_KWH=3000
DEFAULT_FAILURE_BUFFER_PERCENT=10
DEFAULT_MARKUP_MULTIPLIER=2.5
DEFAULT_LABOR_RATE_VND_PER_HOUR=50000
